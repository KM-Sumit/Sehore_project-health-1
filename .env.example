# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookmytest
# Direct connection for Drizzle migrations (optional; falls back to DATABASE_URL)
DATABASE_URL_UNPOOLED=

# App / Environment
NODE_ENV=development
APP_URL=http://localhost:5173

# Auth (JWT + sessions)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_ACCESS_TTL=1h
SESSION_REFRESH_TTL=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 / S3-compatible storage (optional; required for persistent uploads on serverless)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AI providers (optional)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Public origin for adapter-node deployments (optional; ignored by adapter-vercel)
# ORIGIN=https://example.com
